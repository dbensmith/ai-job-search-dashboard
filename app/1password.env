# Deploy settings for 1Password mode (OP_VAULT set): `op run --env-file 1password.env` resolves each reference at run
# time, so values never touch disk. Committed on purpose: references only, and the vault name comes from OP_VAULT.
# `mise run setup --source 1password` creates the item ai-job-search with these fields. Fields are CONCEALED so op masks them in logs.
CLOUDFLARE_API_TOKEN=op://${OP_VAULT}/ai-job-search/cloudflare_api_token
CLOUDFLARE_HOSTNAME=op://${OP_VAULT}/ai-job-search/hostname
CLOUDFLARE_ACCESS_ALLOWED_EMAILS=op://${OP_VAULT}/ai-job-search/allowed_emails
# OpenTofu state and plan encryption (HCL, generated by setup). Encrypts the state in R2, which has no customer-managed keys.
TF_ENCRYPTION=op://${OP_VAULT}/ai-job-search/tf_encryption
